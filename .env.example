DATABASE_URL="file:./dev.db"
# For production Postgres:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/quotedesk"

# --- Inbound email (Phase A) -------------------------------------------------
# Shared secret for POST /api/inbound-email. The route refuses every request
# until this is set — unauthenticated mail must not enter the pipeline.
# Send it as the X-QuoteDesk-Secret header or a ?secret= query parameter.
INBOUND_WEBHOOK_SECRET=""

# Where attachment bytes are written. Metadata goes to the database; the bytes
# stay on disk and are read back at ingest time by the document extractor.
INBOUND_STORAGE_DIR="storage/inbound"

# --- Estimator notification (Phase D) ---------------------------------------
# Who gets the "draft ready" email. Defaults to the workspace estimator's
# address. This is the shop's own estimator — never the buyer; a notification
# addressed to the RFQ sender is refused.
NOTIFY_EMAIL=""
# Verified sender address for outbound notification mail.
NOTIFY_FROM_EMAIL=""
# Optional. Without it, in-app notifications still work and the record reads
# "not_sent:no_provider_configured".
RESEND_API_KEY=""
# Base URL used in notification links.
APP_URL="http://localhost:3000"

# --- Anthropic API ----------------------------------------------------------
# Used for two things, both of which degrade cleanly when this is unset:
#
#  1. Borderline RFQ classification. The deterministic rules classifier always
#     runs; the model is only asked for a second opinion in the 0.35-0.70 band.
#  2. Reading attached drawings and PDFs (src/lib/documents). Most fabrication
#     RFQs carry their specification in an attachment rather than the email
#     body, and a scanned print has no text layer to parse. Without a key the
#     attachments are stored and listed as unread, and the RFQ is drafted from
#     the body alone.
#
# No model output ever becomes a price. Document extraction produces the same
# specification fields the text parser produces, and they pass through the same
# confidence gate.
ANTHROPIC_API_KEY=""

# Documents read per RFQ, and the per-document size ceiling in bytes. Caps, not
# preferences: an inbound webhook is an untrusted entry point.
# DOCUMENT_MAX_COUNT=5
# DOCUMENT_MAX_BYTES=8388608
